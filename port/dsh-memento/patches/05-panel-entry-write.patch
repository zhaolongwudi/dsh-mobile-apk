+/**
+ * [port fix #4] 面板「新增」表单的工作区候选键。
+ *
+ * 组成：① 已有条目里出现过的非空 workspaceKey（人能在列表里看到的东西，就是可写入面）；
+ * ② 活会话的 cwd 归一化键（宿主 sessions 服务在场时）。去重、排序，上限 50 条
+ * 只影响下拉宽度，不影响写入能力（前端始终允许手填）。
+ * 纯读取，不触碰 store 写面；sessions 服务缺席时静默退化为仅有键集。
+ * @param {import('./types.js').Context} ctx - 插件上下文。
+ * @param {MemoryService} service - ctx.memory。
+ * @returns {string[]} 去重后的工作区键（字典序）。
+ */
+function panelWorkspaceKeys(ctx, service) {
+  /** @type {Set<string>} */
+  const keys = new Set()
+  try {
+    for (const entry of service.store.listEntries()) {
+      if (typeof entry.workspaceKey === 'string' && entry.workspaceKey.length > 0) keys.add(entry.workspaceKey)
+    }
+  } catch {
+    // store 不可读：退化为只有活会话部分（写路由自己会再校验一次）。
+  }
+  try {
+    const sessions = ctx.get('sessions')
+    const live = typeof sessions?.list === 'function' ? sessions.list() : []
+    for (const session of live) {
+      const key = workspaceKeyOf(session?.header?.cwd)
+      if (key.length > 0) keys.add(key)
+    }
+  } catch {
+    // sessions 服务不可读：按无活会话处理。
+  }
+  return [...keys].sort().slice(0, 50)
+}
