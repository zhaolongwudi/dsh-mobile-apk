+/**
+ * [port fix] 面板写路由的会话句柄：审计行要带 sessionId、会话事件要挂到正确会话上，
+ * 因此批准路径需要一个 session 对象。宿主的 `sessions` 服务（SessionStore）能按 id 取**活会话**；
+ * 提案所属会话可能已不在内存（引擎重启后），此时退化为只带 id 的会话壳：
+ * 它的 append 是显式 no-op（非活会话本来就不能追加事件；`maybeAppendSessionEvent` 另有
+ * 「宿主是否收录 memory/*」的已知类型门，且不消费 append 的返回值），
+ * 这样做的目的是保住审计行的 sessionId 溯源，同时绝不在写已落盘之后再抛错。
+ * @param {import('./types.js').Context} ctx - 插件上下文。
+ * @param {string | null} sessionId - 提案记录的会话 id。
+ * @returns {object} 会话句柄（活会话对象或只带 id 的壳）。
+ */
+function panelSessionFor(ctx, sessionId) {
+  const id = typeof sessionId === 'string' ? sessionId : ''
+  /** @type {object | undefined} */
+  let live
+  try {
+    live = id.length === 0 ? undefined : ctx.get('sessions')?.get?.(id)
+  } catch {
+    // sessions 服务不可读（非 web/headless 装配）：按「无活会话」处理，仍保留 id 溯源。
+    live = undefined
+  }
+  if (live !== undefined && live !== null) return live
+  return { id: id.length === 0 ? null : id, append: () => 'panel:no-live-session' }
+}
+
+/**
+ * [port fix] 面板写路由的准入判定。
+ *
+ * 只读面板路由历史上不校验来源（读自己的记忆库不构成越权）。写路由不同：它能让
+ * 记忆库永久变更，因此按宿主既有的 browser-auth 语义收口——`connection.requestRejection`
+ * 是宿主给插件用的公开判定（同 @dsh-android/dsh-session-delete 的做法）。
+ * connection 服务不在场时（非 web profile）退化放行：此时路由根本没有浏览器可达面。
+ * @param {import('@deepseek-ai/cordis').Context} ctx - Cordis 上下文。
+ * @param {{headers?: object}} req - 请求。
+ * @param {PanelResponse} res - 响应（拒绝时由本函数写完）。
+ * @returns {boolean} true = 可以继续处理。
+ */
+function authorizePanelWrite(ctx, req, res) {
+  /** @type {number | undefined} */
+  let rejection
+  try {
+    const connection = ctx.get('connection')
+    if (typeof connection?.requestRejection === 'function') rejection = connection.requestRejection(req)
+  } catch {
+    // 判定不可读按未授权处理（失败封闭）。
+    rejection = 401
+  }
+  if (rejection === undefined) return true
+  res.writeHead(rejection, { 'cache-control': 'no-store', 'content-type': 'application/json; charset=utf-8' })
+  res.end(JSON.stringify({ ok: false, error: rejection === 403 ? 'forbidden-origin' : 'unauthenticated' }))
+  return false
+}
+
+/**
+ * [port fix] 读取并解析面板写路由的 JSON 请求体（上限 64 KiB，超限失败封闭）。
+ * @param {{on?: Function, destroy?: Function}} req - 请求流。
+ * @returns {Promise<Record<string, unknown>>} 解析后的对象。
+ */
+async function readPanelJsonBody(req) {
+  const MAX = 64 * 1024
+  /** @type {Buffer[]} */
+  const chunks = []
+  let size = 0
+  /** @type {Buffer} */
+  const body = await new Promise((resolve, reject) => {
+    if (typeof req.on !== 'function') {
+      resolve(Buffer.alloc(0))
+      return
+    }
+    req.on('data', (/** @type {Buffer} */ chunk) => {
+      size += chunk.length
+      if (size > MAX) {
+        reject(new InvalidInputError('panel request body too large'))
+        return
+      }
+      chunks.push(chunk)
+    })
+    req.on('end', () => resolve(Buffer.concat(chunks)))
+    req.on('error', (/** @type {Error} */ error) => reject(error))
+  })
+  if (body.length === 0) return {}
+  try {
+    const parsed = JSON.parse(body.toString('utf8'))
+    return parsed !== null && typeof parsed === 'object' ? parsed : {}
+  } catch {
+    throw new InvalidInputError('panel request body is not valid JSON')
+  }
+}
