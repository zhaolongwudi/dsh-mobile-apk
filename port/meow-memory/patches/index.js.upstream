      if (sw.mode === "failed") return { note: `\u5207\u6362\u5931\u8D25\uFF1A${sw.error}\u3002\u4ECD\u4F7F\u7528 ${sw.from}\uFF0C\u6570\u636E\u672A\u53D7\u5F71\u54CD\uFF0C\u53EF\u7A0D\u540E\u91CD\u8BD5\u3002` };
